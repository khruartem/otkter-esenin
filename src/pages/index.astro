---
import BaseLayout from "../layouts/BaseLayout.astro";
import EventStructuredData from "../components/seo/EventStructuredData.astro";
import Modal from "../components/ui/Modal.astro";
import PhotoModalView from "../components/view/PhotoModalView.astro";

import Hero from "../components/sections/Hero.astro";
import Second from "../components/sections/Second.astro";
import Artists from "../components/sections/Artists.astro";
import Communications from "../components/sections/Communications.astro";

import { photos } from "../data/photos";
---

<BaseLayout>
  <EventStructuredData slot="head" />

  <main class="flex flex-col gap-2.5 md:gap-5 lg:gap-2.5 xl:gap-5 2xl:gap-10">
    <Hero />
    <Second />
    <Artists />
    <Communications />
  </main>

  <Modal />
  <PhotoModalView count={photos.length} />
</BaseLayout>
