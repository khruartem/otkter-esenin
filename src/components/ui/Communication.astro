---
import type { Communication } from "../../data/communications";

import Arrow from "../../assets/icons/arrow_media.svg";

type Props = Communication;

const { media, title, url } = Astro.props;
---

<a
  href={url}
  target="_blank"
  class="communication flex flex-col lg:max-w-114.5 lg:px-6 xl:max-w-141 2xl:max-w-96"
  data-communication
>
  <h3
    class="communication__media typography-body-sm text-sun-100 flex h-8 items-center"
  >
    <span class="whitespace-nowrap" data-communication-media>{media}</span>
    <span data-communication-arrow class="communication__arrow h-auto w-8"
      ><Arrow /></span
    >
  </h3>
  <p
    class="communication__title typography-accent-sm text-white-20 lg:typography-accent-md"
  >
    {title}
  </p>
</a>

<style>
  .communication {
    --animation: 0.3s ease-out;

    width: 100%;
    padding-block-start: 0;
  }

  .communication__arrow {
    margin-inline-start: var(--media-width);
    transition: margin-inline-start var(--animation);
  }

  .communication__title {
    transition: color var(--animation);
  }

  .communication:hover .communication__title {
    color: var(--color-white-100);
  }

  .communication:active > * {
    color: var(--color-white-100);
  }
</style>
