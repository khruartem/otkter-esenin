---
import BuyButton from "./BuyButton.astro";

import { performanceEvent } from "../../data/event";

interface Props {
  compacted?: boolean;
  class?: string;
}

const { compacted = false, class: className = "" } = Astro.props;

const DATE_TIME = performanceEvent.startDate;
const DATE_TIME_LABEL = performanceEvent.dateLabel;

const ADRESS_PART_1 = performanceEvent.venue.name;
const ADRESS_PART_2 = `г. ${performanceEvent.venue.city}, ${performanceEvent.venue.streetAddress}`;
const ADRESS_FULL = `${ADRESS_PART_1}, ${ADRESS_PART_2}`;
---

<div class:list={["flex flex-col items-center gap-5 md:gap-7", className]}>
  <BuyButton />
  <div class="flex flex-col items-center gap-2 px-15.5 md:px-0">
    <p class="typography-accent-md text-white-100">
      <time datetime={DATE_TIME}>
        {DATE_TIME_LABEL}
      </time>
    </p>
    <div
      class="typography-body-sm text-white-20 flex min-w-62 flex-col items-center"
    >
      <p class:list={["hidden md:block", compacted ? "lg:hidden" : ""]}>
        {ADRESS_FULL}
      </p>
      <p class:list={["block md:hidden", compacted ? "lg:block" : ""]}>
        {ADRESS_PART_1}
      </p>
      <p class:list={["block md:hidden", compacted ? "lg:block" : ""]}>
        {ADRESS_PART_2}
      </p>
    </div>
  </div>
</div>
