---
import BuyButton from "./BuyButton.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex flex-col items-center gap-5 md:gap-7", className]}>
  <BuyButton />
  <div class="flex flex-col items-center gap-2 px-15.5 md:px-0">
    <p class="typography-accent-md text-white-100">6 октября, 19:00</p>
    <div
      class="typography-body-sm text-white-20 flex min-w-62 flex-col items-center"
    >
      <p class="hidden md:block lg:hidden">
        МУК «Районный дом культуры», г. Ногинск, ул. Текстилей, д. 31
      </p>
      <p class="block md:hidden lg:block">МУК «Районный дом культуры»,</p>
      <p class="block md:hidden lg:block">г. Ногинск, ул. Текстилей, д. 31</p>
    </div>
  </div>
</div>
