---
import Button from "./Button.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const BUY_TICKET =
  "https://biletof.com/action/?ra=20043&frame=1&action=11787&place=47";
---

<div class:list={["flex flex-col items-center gap-5 md:gap-7", className]}>
  <Button
    href={BUY_TICKET}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full md:w-fit">Купить билет</Button
  >
  <div class="flex flex-col items-center gap-2 px-15.5 md:px-0">
    <p class="typography-accent-md text-white-100">6 октября, 19:00</p>
    <p class="typography-body-sm text-white-20">
      МУК «Районный дом культуры», г. Ногинск, ул. Текстилей, д. 31
    </p>
  </div>
</div>
