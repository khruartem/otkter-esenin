---
import type { HTMLAttributes } from "astro/types";

type ButtonProps = HTMLAttributes<"button"> & {
  href?: never;
};

type LinkProps = HTMLAttributes<"a"> & {
  type?: never;
  disabled?: never;
};

type Props = ButtonProps | LinkProps;

const {
  href,
  type = "button",
  disabled = false,
  class: className,
  ...restProps
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      {...restProps}
      class:list={["action", "typography-label", className]}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      {...restProps}
      class:list={["action", "typography-label", className]}
    >
      <slot />
    </button>
  )
}

<style>
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding-block: 10px 6px;
    padding-inline: 32px;

    color: var(--color-dark-100);
    background-color: var(--color-sun-100);

    border: 0;
    border-radius: 100px;

    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .action:not(:disabled):hover {
    background-color: var(--color-sun-80);
  }

  .action:not(:disabled):active {
    background-color: var(--color-white-100);
  }

  .action:focus-visible {
    outline: 2px solid var(--color-white-100);
    outline-offset: 3px;
  }

  .action:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }
  }
</style>
