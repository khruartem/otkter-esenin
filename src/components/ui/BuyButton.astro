---
import Button from "./Button.astro";

import { performanceEvent } from "../../data/event";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const BUY_TICKET = performanceEvent.ticketURL;
---

<Button
  href={BUY_TICKET}
  target="_blank"
  rel="noopener noreferrer"
  class={className}>Купить билет</Button
>
