---
import Button from "./Button.astro";
import Close from "../../assets/icons/close.svg";
---

<dialog class="modal" data-modal>
  <Button
    class="modal__close"
    type="button"
    aria-label="Закрыть"
    data-modal-close><Close /></Button
  >

  <div class="max-h-full xl:w-6xl 2xl:w-440" data-modal-content></div>
</dialog>

<style>
  .modal {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100dvh;

    max-width: none;
    max-height: none;

    background-color: var(--color-background);

    padding-inline: 19px;
    border: 0;

    margin: 0;
    padding: 0;
    border: 0;

    overflow: hidden;
  }

  /* .modal::backdrop {
    background: rgb(0 0 0 / 70%);
  } */

  .modal[open] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .modal:not([open]) {
    display: none;
  }

  .modal__close {
    position: absolute;
    top: 16px;
    right: 22px;
    z-index: 1;
  }

  @media (min-width: 48rem) {
    .modal {
      padding-inline: 30px;
    }

    .modal__close {
      top: 30px;
      right: 30px;
    }
  }

  @media (min-width: 64rem) {
    .modal {
      padding-inline: 42px;
    }

    .modal__close {
      top: 42px;
      right: 42px;
    }
  }

  @media (min-width: 80rem) {
    .modal {
      justify-content: flex-start;

      padding-block-start: 32px;
      padding-inline: 0;
    }

    .modal__close {
      top: 32px;
      right: 32px;
    }
  }

  @media (min-width: 96rem) {
    .modal {
      padding-block-start: 48px;
    }

    .modal__close {
      top: 48px;
      right: 48px;
    }
  }
</style>
