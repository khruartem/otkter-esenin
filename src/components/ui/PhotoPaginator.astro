---
interface Props {
  count: number;
}

const { count } = Astro.props;
---

<ul
  class="photo-pagination"
  data-photo-pagination
  aria-label="Навигация по фотографиям"
>
  {
    Array.from({ length: count }, (_, index) => (
      <li>
        <button
          type="button"
          class="photo-pagination__item"
          data-pagination-index={index}
          aria-label={`Показать фотографию ${index + 1}`}
        >
          <span class="photo-pagination__dot" aria-hidden="true" />
        </button>
      </li>
    ))
  }
</ul>

<style>
  .photo-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .photo-pagination__item {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 2px;
    border: 0;
    border-radius: 50%;

    background: transparent;
    cursor: pointer;
  }

  .photo-pagination__item:focus-visible {
    outline: 2px solid var(--color-sun-100);
    outline-offset: 2px;
  }

  .photo-pagination__dot {
    display: block;

    width: 4px;
    height: 4px;

    border-radius: 100px;

    background-color: var(--color-white-60);
  }

  .photo-pagination__item[data-active] .photo-pagination__dot {
    width: 12px;
    height: 6px;

    padding: 1px 0;

    background-color: var(--color-sun-100);
  }

  .photo-pagination__item:hover .photo-pagination__dot {
    transform: scale(2.5);
  }

  .photo-pagination__item[data-active]:hover .photo-pagination__dot {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-pagination__dot {
      transition: none;
    }

    .photo-pagination__item:hover .photo-pagination__dot {
      transform: none;
    }
  }
</style>
