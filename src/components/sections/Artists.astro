---
// import Section from "../layout/Section.astro";
import Container from "../layout/Container.astro";
import Title from "../ui/Title.astro";
import Artist from "../ui/Artist.astro";

import { artists } from "../../data/artists";
---

<section class="artists">
  <Container class="artists__container flex flex-col items-center">
    <Title class="text-dark-100">Творцы</Title>
    <ul class="artists__list flex w-full flex-wrap items-center">
      {
        artists.map((artist) => (
          <li>
            <Artist {...artist} />
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  :global(.artists) {
    background-image: url(../../assets/images/artists/artists_sm.png);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  :global(.artists__container) {
    gap: 60px;

    padding-block-start: 138px;
    padding-block-end: 198px;
  }

  .artists__list {
    justify-content: space-evenly;
    row-gap: 60px;
  }

  @media (min-width: 48rem) {
    :global(.artists) {
      background-image: url(../../assets/images/artists/artists_md.png);
      background-size: cover;
    }

    :global(.artists__container) {
      padding-block-start: 122px;
      padding-block-end: 202px;
    }

    .artists__list {
      row-gap: 80px;
    }
  }

  @media (min-width: 64rem) {
    :global(.artists) {
      background-image: url(../../assets/images/artists/artists_lg.png);
    }

    :global(.artists__container) {
      padding-block-start: 174px;
      padding-block-end: 214px;
    }

    .artists__list {
      justify-content: space-between;
    }
  }

  @media (min-width: 80rem) {
    :global(.artists) {
      background-image: url(../../assets/images/artists/artists_xl.png);
    }

    :global(.artists__container) {
      gap: 80px;

      padding-block-start: 248px;
      padding-block-end: 308px;
    }
  }

  @media (min-width: 96rem) {
    :global(.artists) {
      background-image: url(../../assets/images/artists/artists_2xl.png);
    }

    :global(.artists__container) {
      gap: 108px;

      padding-block-start: 319px;
      padding-block-end: 479px;
    }

    .artists__list {
      justify-content: space-evenly;
    }
  }
</style>
