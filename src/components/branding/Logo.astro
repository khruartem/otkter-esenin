  light: `
    --logo-body-color: var(--color-white-100);
    --logo-circle-color: var(--color-nephritis-120);
  `,
  dark: `
    --logo-body-color: var(--color-navy-100);
    --logo-circle-color: var(--color-white-100);
  `,
} as const;
