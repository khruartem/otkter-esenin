---
import Logo from './Logo.astro';
import EventPlace from "../../assets/icons/event_place.svg";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props as Props;
---

<div class:list={["w-fit h-10 flex items-center gap-5 lg:h-15 lg:gap-8", className]}>
  <Logo variant="dark" class="w-46 max-h-8 lg:w-59 lg:max-h-10" />
  <span
    aria-hidden="true"
    class="h-8 w-px shrink-0 bg-white-100"
  ></span>
  <EventPlace class="h-auto w-16.5 text-navy-100 lg:w-25" aria-label="ДК Богородский" />
</div>
