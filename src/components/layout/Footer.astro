---
import Container from "./Container.astro";
import Logo from "../branding/Logo.astro";
import Copyright from "../ui/Copyright.astro";
import Socials from "../ui/Socials.astro";
---

<footer class="pbs-22.5 pbe-4 md:pbs-19 lg:pbs-16.5 xl:pbs-19 2xl:pbs-24">
  <Container class="flex flex-col gap-12">
    <div class="flex flex-wrap items-start justify-between gap-y-10">
      <Logo variant="light" class="max-h-10.5 w-62" />
      <div class="flex flex-col items-start gap-2 md:items-end">
        <span class="text-white-100 typography-body-sm">Свяжитесь с нами</span>
        <div
          class="text-nephritis-120 typography-accent-md flex flex-col items-start md:items-end"
        >
          <a href="mailto:hello@otkter.ru">hello@otkter.ru</a>
          <a href="tel:+74965156087">+7 (496) 515-60-87</a>
        </div>
      </div>
    </div>
    <div
      class="border-t-nephritis-120 flex flex-nowrap items-center border-t border-solid pbs-4 md:justify-between"
    >
      <Copyright />
      <Socials />
    </div>
  </Container>
</footer>
