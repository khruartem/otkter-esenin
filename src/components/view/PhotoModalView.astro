---
import Button from "../ui/Button.astro";

import Previous from "../../assets/icons/arrow_left.svg";
import Next from "../../assets/icons/arrow_right.svg";
---

<template data-photo-modal-template>
  <div class="photo-modal">
    <Button
      class="photo-modal__button photo-modal__button_left"
      data-button-previous><Previous /></Button
    >
    <img class="photo-modal__image" data-photo-modal-image alt="" />
    <Button
      class="photo-modal__button photo-modal__button_right"
      data-button-next><Next /></Button
    >
  </div>
</template>

<style>
  .photo-modal {
    display: flex;

    position: relative;
  }

  .photo-modal__button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .photo-modal__button_left {
    left: 0;
  }

  .photo-modal__button_right {
    right: 0;
  }

  .photo-modal__image {
    width: 100%;
    max-height: 216px;

    object-fit: contain;
  }

  @media (min-width: 48rem) {
    .photo-modal__image {
      max-height: 400px;
    }
  }

  @media (min-width: 64rem) {
    .photo-modal__image {
      max-height: 532px;
    }
  }

  @media (min-width: 80rem) {
    .photo-modal {
      width: 100%;
      height: 100%;

      justify-content: space-between;
      align-items: center;
    }

    .photo-modal__button {
      position: unset;
      top: unset;
      transform: unset;
    }

    .photo-modal__image {
      width: unset;
      height: 100%;

      max-width: 956px;
      max-height: unset;
    }
  }

  @media (min-width: 96rem) {
    .photo-modal__image {
      max-width: 1366px;
    }
  }
</style>
